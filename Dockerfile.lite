# 精简镜像：不含 Chromium（约 300~350MB），用于「先把服务跑起来」
#
# 为什么需要它：完整版镜像 1.3GB、压缩后仍有 ~430MB，推 TCR 时单层经常
#   `net/http: timeout awaiting response headers`（云托管构建机到镜像仓库的上传带宽
#   只有 3MB/s 上下，两个大层并发就必挂）。精简版最大层只有 npm 依赖的 ~30MB，
#   推送 20 秒内就能过。
#
# 代价：云端「全网搜索 / 粘贴链接导入 / 补章」不可用（会返回明确错误，不会静默失败）。
#       已入库的 85 本书 / 4400+ 章、登录、书架、分类、阅读、目录全部正常。
#
# 用法：container.config.json 的 dockerfilePath 指向本文件即可（当前默认）。
#       要恢复云端抓取，改回 "Dockerfile"。
FROM node:20-bookworm-slim

ENV NODE_ENV=production \
    PORT=80 \
    TZ=Asia/Shanghai \
    DEBIAN_FRONTEND=noninteractive \
    PW_DISABLED=1 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

WORKDIR /app

# 中文字体 + 时区（生僻字/简介显示需要）
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tzdata fonts-liberation \
 && rm -rf /var/lib/apt/lists/*

COPY server/package.json server/package-lock.json ./
# 不装 playwright 的浏览器，但保留包本身（代码里 require 会用到）
RUN npm ci --omit=dev --no-audit --no-fund && rm -rf /root/.npm /root/.cache /tmp/*

COPY server/ ./

EXPOSE 80

CMD ["node", "app.js"]

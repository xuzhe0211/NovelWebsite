# 服务端口
PORT=3000

# MySQL 连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=novel
DB_USER=root
DB_PASS=root

# JWT 签名密钥（生产环境务必替换为强随机值）
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

# 微信小程序（测试号/正式号均可配置）
# 获取：https://mp.weixin.qq.com → 登录小程序 → 开发管理 → 开发设置 → 开发者ID（AppID / AppSecret）
# AppID 需与 miniprogram/project.config.json 的 appid 一致；AppSecret 只在服务端使用
WX_APPID=
WX_SECRET=

# ===== 爬虫配置 =====
# 数据源：qimao(七猫) | fanqie(番茄) | twkan
CRAWL_SOURCE=qimao
# 种子书籍ID（逗号分隔）。留空则从 CRAWL_LIST_URL / 数据源首页自动发现
CRAWL_SEED_IDS=
# 书库/首页地址：无 CRAWL_SEED_IDS 时用于发现书籍
# 七猫：https://www.qimao.com/
# 番茄：https://fanqienovel.com/library
CRAWL_LIST_URL=https://www.qimao.com/
# 单次最多抓取书籍数（从列表页发现时生效）
CRAWL_MAX_BOOKS=3
# 每章节请求间隔毫秒
CRAWL_INTERVAL_MS=800
# 单次抓取章节上限（0=不限；调试时设 3 快速验证）
CRAWL_LIMIT=0
# 每周调度 cron 表达式（默认每周日 03:00）
CRAWL_SCHEDULE=0 3 * * 0
# 日志级别
LOG_LEVEL=info

# ===== 阅读限制 =====
# 未登录用户每本书最多可读的章节数（按章节序号），0 = 不限制
# 服务端硬限制：超出的章节正文不会下发，直接返回 code=403
FREE_CHAPTERS=10

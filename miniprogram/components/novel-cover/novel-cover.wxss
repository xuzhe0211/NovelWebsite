:host {
  display: block;
}

.nc {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  flex-shrink: 0;
  background: linear-gradient(152deg, #4b5c70, #222d3a);
}

/* 大号水印字 */
.nc-mark {
  position: absolute;
  right: -0.1em;
  bottom: -0.26em;
  font-family: 'Songti SC', 'STSong', 'Noto Serif SC', serif;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.07);
  line-height: 1;
  pointer-events: none;
}

/* 左上角柔光 */
.nc-glow {
  position: absolute;
  left: -20%;
  top: -30%;
  width: 110%;
  height: 90%;
  background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0) 62%);
  pointer-events: none;
}

/* 内描边，做出书封质感 */
.nc::after {
  content: '';
  position: absolute;
  left: 6rpx;
  right: 6rpx;
  top: 6rpx;
  bottom: 6rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 4rpx;
  pointer-events: none;
}

.nc-body {
  position: relative;
  z-index: 2;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-start;
}

.nc-tag {
  max-width: 100%;
  color: rgba(255, 255, 255, 0.82);
  background: rgba(255, 255, 255, 0.15);
  border-radius: 6rpx;
  line-height: 1.5;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.nc-foot {
  width: 100%;
}

.nc-title {
  width: 100%;
  color: #f8f4ea;
  font-family: 'Songti SC', 'STSong', 'Noto Serif SC', serif;
  font-weight: 700;
  letter-spacing: 1rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.24);
}

.nc-author {
  width: 100%;
  color: rgba(248, 244, 234, 0.62);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.nc-img {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 3;
  width: 100%;
  height: 100%;
  display: block;
  background: transparent;
}

.nc-badge {
  position: absolute;
  right: 0;
  bottom: 0;
  z-index: 4;
  padding: 2rpx 10rpx;
  font-size: 18rpx;
  line-height: 1.5;
  color: #fff;
  background: rgba(232, 115, 59, 0.94);
  border-radius: 10rpx 0 10rpx 0;
}

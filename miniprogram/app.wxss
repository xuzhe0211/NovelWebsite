/* ================= 全局样式 ================= */
page {
  background: #f5f6f8;
  color: #1f2329;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
image {
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(17, 24, 39, 0.04);
}

/* 文本省略 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 主色 */
.text-primary { color: #e8733b; }
.bg-primary { background: #e8733b; }

/* 列表行 */
.row {
  display: flex;
  align-items: center;
}

/* 区块标题 */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx 4rpx 16rpx;
}
.section-title {
  position: relative;
  padding-left: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
  line-height: 1.2;
}
.section-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 6rpx;
  bottom: 6rpx;
  width: 8rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #ff9a5c, #e8733b);
}
.section-more {
  font-size: 24rpx;
  color: #9aa0a6;
}

/* 标签 / 筛选 chip */
.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 28rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  background: #fff;
  color: #61666d;
  font-size: 26rpx;
  transition: all 0.16s ease;
}
.chip.active {
  background: linear-gradient(135deg, #ff9457, #e8733b);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(232, 115, 59, 0.28);
}

/* 排序分段控件 */
.seg {
  display: flex;
  padding: 8rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(17, 24, 39, 0.04);
}
.seg-item {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 28rpx;
  color: #61666d;
  border-radius: 12rpx;
  transition: all 0.16s ease;
}
.seg-item.active {
  background: linear-gradient(135deg, #ff9457, #e8733b);
  color: #fff;
  font-weight: 600;
}

/* 空状态 / 加载态 */
.loading-tip {
  text-align: center;
  color: #9aa0a6;
  padding: 32rpx 0;
  font-size: 24rpx;
}

/* 骨架屏 */
.skeleton {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
}
.sk-row {
  display: flex;
  padding: 20rpx 0;
}
.sk-cover {
  width: 120rpx;
  height: 160rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.sk-lines {
  flex: 1;
  padding-top: 8rpx;
}
.sk-line {
  height: 26rpx;
  border-radius: 8rpx;
  margin-bottom: 18rpx;
}
.sk-line.w60 { width: 60%; }
.sk-line.w40 { width: 40%; }
.sk-line.w80 { width: 80%; }
.sk-cover,
.sk-line {
  background: linear-gradient(90deg, #eef0f3 25%, #f7f8fa 37%, #eef0f3 63%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
}
@keyframes shimmer {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

/* 可点击反馈 */
.hover {
  opacity: 0.7;
}

button::after {
  border: none;
}

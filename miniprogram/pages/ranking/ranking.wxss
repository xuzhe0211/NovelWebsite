.ranking {
  padding: 24rpx 24rpx 40rpx;
}

.tip-line {
  margin: 20rpx 4rpx 4rpx;
  font-size: 22rpx;
  color: #a8adb5;
}

/* 前三名 */
.podium {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 28rpx 16rpx 24rpx;
  background: linear-gradient(160deg, #fff7f1 0%, #ffffff 58%);
  border: 1rpx solid #ffe9d9;
  border-radius: 24rpx;
}
.p-item {
  width: 31%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.p-cover-wrap {
  position: relative;
  width: 168rpx;
  height: 224rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #eceef1;
  box-shadow: 0 8rpx 20rpx rgba(120, 76, 40, 0.16);
}
.p-cover {
  width: 168rpx;
  height: 224rpx;
  display: block;
}
.p-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f8d6bf, #e8a87c);
  color: #fff;
  font-size: 56rpx;
  font-weight: 700;
}
.p-badge {
  position: absolute;
  left: 0;
  top: 0;
  min-width: 48rpx;
  height: 40rpx;
  padding: 0 10rpx;
  line-height: 40rpx;
  text-align: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 0 0 16rpx 0;
}
.p-badge.r1 {
  background: linear-gradient(135deg, #f7b733, #e8901f);
}
.p-badge.r2 {
  background: linear-gradient(135deg, #b9c2cc, #8e99a6);
}
.p-badge.r3 {
  background: linear-gradient(135deg, #d9a179, #b47c56);
}
.p-title {
  width: 100%;
  margin-top: 16rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
}
.p-sub {
  width: 100%;
  margin-top: 6rpx;
  text-align: center;
  font-size: 20rpx;
  color: #b06a41;
}

.list {
  padding: 0 24rpx;
  margin-top: 20rpx;
}

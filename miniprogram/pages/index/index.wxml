<view class="home">
  <!-- 顶部渐变区 -->
  <view class="hero">
    <view class="hero-top">
      <view class="hero-text">
        <view class="hero-title">今天读点什么</view>
        <view class="hero-sub">好书免费读 · 每周持续更新</view>
      </view>
      <view class="hero-badge">全站免费</view>
    </view>

    <view class="search-box" hover-class="hover" bindtap="goSearch">
      <view class="search-icon"></view>
      <text class="search-placeholder">搜索书名 / 作者</text>
      <text class="search-online" catchtap="goOnlineSearch">全网搜书</text>
    </view>
  </view>

  <view class="body">
    <demo-tip show="{{demoMode}}" bind:retry="retry" />

    <!-- 分类快捷入口 -->
    <scroll-view wx:if="{{categories.length}}" scroll-x class="cat-scroll" enhanced show-scrollbar="{{false}}">
      <view class="chip" wx:for="{{categories}}" wx:key="id" data-slug="{{item.slug}}" bindtap="goCategory">{{item.name}}</view>
    </scroll-view>

    <!-- 热门推荐 -->
    <block wx:if="{{hot.length}}">
      <view class="section-head">
        <view class="section-title">热门推荐</view>
        <view class="section-more" bindtap="goRanking">完整榜单 ›</view>
      </view>
      <scroll-view scroll-x class="hot-scroll" enhanced show-scrollbar="{{false}}">
        <view class="hot-item" wx:for="{{hot}}" wx:key="id" data-id="{{item.id}}" hover-class="hover" bindtap="goDetail">
          <view class="hot-cover-wrap">
            <novel-cover
              src="{{item.coverUrl}}"
              title="{{item.title}}"
              author="{{item.author}}"
              size="{{200}}"
              radius="{{14}}"
            />
            <view wx:if="{{item.isCompleted}}" class="hot-tag done">完结</view>
            <view wx:else class="hot-tag">{{item.category.name}}</view>
          </view>
          <view class="hot-title ellipsis">{{item.title}}</view>
          <view class="hot-meta ellipsis">
            <text class="hot-author">{{item.author || '佚名'}}</text>
            <text class="hot-hot">{{item.hotText}}人气</text>
          </view>
        </view>
      </scroll-view>
    </block>

    <!-- 最近更新 -->
    <block wx:if="{{latest.length}}">
      <view class="section-head">
        <view class="section-title">最近更新</view>
      </view>
      <view class="list card">
        <novel-card wx:for="{{latest}}" wx:key="id" novel="{{item}}" showIntro="{{false}}" />
      </view>
    </block>

    <!-- 骨架屏 -->
    <view wx:if="{{loading}}" class="skeleton">
      <view class="sk-row" wx:for="{{skeleton}}" wx:key="*this">
        <view class="sk-cover"></view>
        <view class="sk-lines">
          <view class="sk-line w60"></view>
          <view class="sk-line w40"></view>
          <view class="sk-line w80"></view>
        </view>
      </view>
    </view>

    <empty-state
      wx:if="{{!loading && !latest.length}}"
      text="{{error || '暂无数据，请先运行爬虫抓取小说'}}"
      showButton
      buttonText="重新加载"
      bind:button="retry"
    />
  </view>
</view>

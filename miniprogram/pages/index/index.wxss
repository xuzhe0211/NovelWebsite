.home {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 顶部渐变 */
.hero {
  padding: 36rpx 32rpx 40rpx;
  background: linear-gradient(135deg, #ff9a5c 0%, #e8733b 55%, #d95f2a 100%);
  border-radius: 0 0 36rpx 36rpx;
}
.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.hero-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 1rpx;
}
.hero-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}
.hero-badge {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.36);
  color: #fff;
  font-size: 22rpx;
}
.search-box {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  padding: 20rpx 26rpx;
  background: #fff;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(120, 52, 16, 0.18);
}
.search-icon {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #c3c7cf;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.search-icon::after {
  content: "";
  position: absolute;
  right: -10rpx;
  bottom: -4rpx;
  width: 12rpx;
  height: 3rpx;
  background: #c3c7cf;
  border-radius: 2rpx;
  transform: rotate(45deg);
}
.search-placeholder {
  color: #a8adb5;
  font-size: 26rpx;
  flex: 1;
}

/* 首页搜索框内的「全网搜书」快捷入口 */
.search-online {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  border-radius: 22rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #ff9a5c, #e8733b);
}

.body {
  padding: 0 24rpx;
}

/* 分类 */
.cat-scroll {
  white-space: nowrap;
  margin-top: 24rpx;
}
.cat-scroll .chip {
  margin-right: 16rpx;
  background: #fff;
  border: 1rpx solid #f0f1f3;
}

/* 热门横滑 */
.hot-scroll {
  white-space: nowrap;
}
.hot-item {
  display: inline-block;
  width: 200rpx;
  margin-right: 22rpx;
  vertical-align: top;
}
.hot-cover-wrap {
  position: relative;
  width: 200rpx;
  height: 266rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #eceef1;
}
.hot-cover {
  width: 200rpx;
  height: 266rpx;
  display: block;
}
.hot-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f8d6bf, #e8a87c);
  color: #fff;
  font-size: 64rpx;
  font-weight: 700;
}
.hot-tag {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.42);
  color: #fff;
  font-size: 20rpx;
}
.hot-tag.done {
  background: rgba(232, 115, 59, 0.92);
}
.hot-title {
  margin-top: 14rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #1f2329;
}
.hot-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #9aa0a6;
}
.hot-author {
  max-width: 110rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hot-hot {
  color: #e8733b;
}

.list {
  padding: 0 24rpx;
}

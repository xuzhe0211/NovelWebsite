.mine {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 顶部 */
.hero {
  padding: 40rpx 32rpx 28rpx;
  background: linear-gradient(135deg, #ff9a5c 0%, #e8733b 58%, #d95f2a 100%);
  border-radius: 0 0 36rpx 36rpx;
}
.user {
  display: flex;
  align-items: center;
}
.avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.24);
  border: 3rpx solid rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.avatar-img {
  width: 116rpx;
  height: 116rpx;
}
.avatar-text {
  color: #fff;
  font-size: 46rpx;
  font-weight: 700;
}
.user-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}
.nick {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}
.sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
}
.login-mini {
  flex-shrink: 0;
  padding: 12rpx 30rpx;
  border-radius: 30rpx;
  background: #fff;
  color: #e8733b;
  font-size: 26rpx;
  font-weight: 600;
}
.edit-mini {
  flex-shrink: 0;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.86);
}

.stats {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  padding: 22rpx 0;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
}
.stat {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.1;
}
.unit {
  font-size: 22rpx;
  font-weight: 500;
  margin-left: 2rpx;
}
.stat-lab {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
}
.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.3);
}

.body {
  padding: 24rpx;
}

/* 最近在读 */
.recent-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.recent-body {
  display: flex;
  margin-top: 18rpx;
}
.r-cover {
  width: 104rpx;
  height: 140rpx;
  border-radius: 10rpx;
  background: #eceef1;
  flex-shrink: 0;
}
.r-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f8d6bf, #e8a87c);
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
}
.r-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.r-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}
.r-chapter {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #9aa0a6;
}
.r-bar {
  margin-top: 18rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #f1f2f4;
  overflow: hidden;
}
.r-bar-inner {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #ff9a5c, #e8733b);
}

/* 菜单 */
.menu {
  padding: 0 24rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
  border-bottom: 1rpx solid #f2f3f5;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-hover {
  opacity: 0.6;
}
.menu-label {
  font-size: 29rpx;
  color: #1f2329;
}
.menu-value {
  font-size: 25rpx;
  color: #a8adb5;
}

.logout {
  margin-top: 32rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 46rpx;
  background: #fff;
  color: #e8733b;
  font-size: 29rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(17, 24, 39, 0.04);
}

.footer {
  margin-top: 40rpx;
  text-align: center;
  font-size: 21rpx;
  color: #c3c7cf;
}

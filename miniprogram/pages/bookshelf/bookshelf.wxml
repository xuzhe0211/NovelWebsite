<view class="bookshelf">
  <block wx:if="{{needLogin}}">
    <empty-state text="登录后同步你的书架" showButton buttonText="立即登录" bind:button="goLogin" />
  </block>

  <block wx:else>
    <view class="head" wx:if="{{list.length}}">
      <view class="head-title">共 {{list.length}} 本藏书</view>
      <view class="head-sub">阅读进度自动同步</view>
    </view>

    <demo-tip show="{{demoMode}}" text="演示模式：书架数据仅保存在本机" bind:retry="retry" />

    <view class="shelf-list card" wx:if="{{list.length}}">
      <view class="shelf-item" wx:for="{{list}}" wx:key="novelId">
        <view class="s-cover" bindtap="goDetail" data-nid="{{item.novelId}}">
          <novel-cover
            src="{{item.novel.coverUrl}}"
            title="{{item.novel.title}}"
            author="{{item.novel.author}}"
            category="{{item.novel.category && item.novel.category.name}}"
            size="{{120}}"
            radius="{{10}}"
            badge="{{item.novel.isCompleted ? '完结' : ''}}"
          />
        </view>

        <view class="s-info">
          <view class="s-title ellipsis" bindtap="goDetail" data-nid="{{item.novelId}}">{{item.novel.title}}</view>
          <view class="s-chapter ellipsis">读到：{{item.lastChapterTitle || '未开始'}}</view>
          <view class="s-progress">
            <view class="bar"><view class="bar-inner" style="width:{{item.lastPosition || 0}}%"></view></view>
            <text class="pct">{{item.lastPosition || 0}}%</text>
          </view>
          <view class="s-actions">
            <text class="s-btn primary" bindtap="continueRead" data-nid="{{item.novelId}}" data-cid="{{item.lastChapterId}}" data-pos="{{item.lastPosition}}">继续阅读</text>
            <text class="s-btn" bindtap="onRemove" data-nid="{{item.novelId}}">移出</text>
          </view>
        </view>
      </view>
    </view>

    <empty-state
      wx:if="{{!loading && !list.length}}"
      text="{{error || '书架还空着，去书城逛逛吧'}}"
      showButton
      buttonText="去书城"
      bind:button="goStore"
    />
    <view wx:if="{{loading}}" class="loading-tip">加载中…</view>
  </block>
</view>
